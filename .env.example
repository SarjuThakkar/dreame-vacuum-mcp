# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# WebSocket URL of the Matter controller (python-matter-server).
# From a bridge-networked container on the same host, reach the host with
# host.docker.internal (requires extra_hosts: host.docker.internal:host-gateway).
MATTER_URL=ws://host.docker.internal:5580/ws

# Matter node ID of the vacuum, assigned at commissioning time.
MATTER_NODE_ID=1
